# ══════════════════════════════════════════════════════════
# Auction Platform — Merged Environment Variables
# Copy to .env and fill in your values
# ══════════════════════════════════════════════════════════

# ── Node ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/auction_db
DATABASE_URL_READONLY=  # Optional: read replica for analytics

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stripe ─────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── S3 / Media ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=auction-media
CDN_URL=https://your-cdn.cloudfront.net

# ── AI Service ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ── Anthropic (Claude) — for AI features ──────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── SendGrid ───────────────────────────────────────────────
SENDGRID_API_KEY=SG....
FROM_EMAIL=noreply@yourplatform.com

# ── Firebase (Push Notifications) ─────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Sentry ─────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
