# ── Database ──────────────────────────────────────────────────────────────────
# Primary (via PgBouncer in production)
DATABASE_URL="postgresql://bidspace:password@localhost:5433/bidspace?pgbouncer=true&connection_limit=1"
# Read replica (optional — analytics queries route here if set)
DATABASE_URL_READONLY="postgresql://bidspace:password@replica:5432/bidspace"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── AWS S3 (item image storage) ───────────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."
S3_BUCKET="bidspace-item-images"
CDN_URL="https://cdn.yourdomain.com"

# ── AI / ML ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
AI_SERVICE_URL="http://localhost:8000"

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="your-org"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="production"
PORT=3001
FRONTEND_URL="https://yourdomain.com"
