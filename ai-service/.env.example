# ─── Database (for pgvector writes in Phase 2) ────────────────────────────────
# LOCAL DEV:
DATABASE_URL="postgresql://user:pass@localhost:5432/auction_db"
# DOCKER:
# DATABASE_URL="postgresql://user:pass@postgres:5432/auction_db"

# ─── Models ───────────────────────────────────────────────────────────────────
# LOCKED: changing this requires a DB migration (vector dimensions are fixed)
SENTENCE_TRANSFORMER_MODEL="all-MiniLM-L6-v2"
MODEL_ARTIFACTS_PATH="app/ml/artifacts"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT="development"

# ─── Claude API (optional — enables deep Listing Guard analysis) ──────────────
# Get from: https://console.anthropic.com
# Leave blank to use regex-only listing guard (still functional)
ANTHROPIC_API_KEY=""
